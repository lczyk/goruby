#!/usr/bin/env bash
# Run each .rb in the evaluator corpus under MRI and diff stdout against the
# sibling `.expected` file (generated by `eval-corpus-expected`).
#
# Sets exit code 1 if any program's output differs from its expected file or
# if any program exits non-zero.
#
# Per-file header `# minversion: X.Y` (within first 5 lines) gates evaluation:
# if the active ORACLE_VER is below that minimum, the file is skipped (counted
# separately from failures). this matches the layout used by the
# version-boundary fixtures under testdata/.
#
# Dot legend: . = pass, F = fail, s = skip, ? = missing .expected.
#
# Env:
#   RUBY        ruby binary to use. defaults to .rubies/versions/$ORACLE_VER/bin/ruby.
#   ORACLE_VER  pinned MRI version under .rubies/versions/. default: 2.6.0.
#               2.6.x inspect formatting matches the `#=>` markers in the
#               corpus (e.g. `{:a=>1}` rather than the 3.4+ shorthand `{a: 1}`).
#   V=1         verbose: show per-file pass/fail line. otherwise pytest-style dots.
#
# Usage:
#   scripts/eval-corpus-oracle                # default: internal/integrationtest/testdata/evaluator/
#   scripts/eval-corpus-oracle path/to/file.rb [more.rb ...]
#   scripts/eval-corpus-oracle path/to/dir    # recurses
set -e

DEFAULT_ROOT="internal/integrationtest/testdata/evaluator"
ORACLE_VER="${ORACLE_VER:-2.6.0}"
RUBY="${RUBY:-.rubies/versions/${ORACLE_VER}/bin/ruby}"
PASS=0
FAIL=0
MISSING=0
SKIPPED=0
FAILED_FILES=()

# extract `# minversion: X.Y` header from first 5 lines of $1. echoes the
# version string, or empty if no header.
function _minversion() {
    awk '
        NR > 5 { exit }
        match($0, /^[ \t]*#[ \t]*minversion:[ \t]*[0-9]+(\.[0-9]+)?/) {
            line = substr($0, RSTART, RLENGTH)
            sub(/^[ \t]*#[ \t]*minversion:[ \t]*/, "", line)
            print line
            exit
        }
    ' "$1"
}

# version compare: returns 0 if $1 >= $2, else 1. components compared numerically.
function _ver_ge() {
    awk -v a="$1" -v b="$2" '
        BEGIN {
            na = split(a, ap, ".")
            nb = split(b, bp, ".")
            n = (na > nb) ? na : nb
            for (i = 1; i <= n; i++) {
                ai = (i <= na) ? ap[i] + 0 : 0
                bi = (i <= nb) ? bp[i] + 0 : 0
                if (ai > bi) { exit 0 }
                if (ai < bi) { exit 1 }
            }
            exit 0
        }
    '
}

function _check_one() {
    local rb="$1"
    local expected="${rb%.rb}.expected"

    local minver
    minver="$(_minversion "$rb")"
    if [ -n "$minver" ] && ! _ver_ge "$ORACLE_VER" "$minver"; then
        SKIPPED=$((SKIPPED + 1))
        if [ "${V:-0}" = "1" ]; then
            printf 'SKIP  %s (needs >= %s)\n' "$rb" "$minver"
        else
            printf 's'
        fi
        return
    fi

    if [ ! -f "$expected" ]; then
        MISSING=$((MISSING + 1))
        FAILED_FILES+=("$rb (no .expected; run eval-corpus-expected)")
        if [ "${V:-0}" = "1" ]; then
            printf 'MISS  %s\n' "$rb"
        else
            printf '?'
        fi
        return
    fi
    local actual
    if ! actual="$("$RUBY" --disable-gems "$rb" 2>/dev/null)"; then
        FAIL=$((FAIL + 1))
        FAILED_FILES+=("$rb (ruby exited non-zero)")
        if [ "${V:-0}" = "1" ]; then
            printf 'FAIL  %s (ruby exit)\n' "$rb"
        else
            printf 'F'
        fi
        return
    fi
    local want
    want="$(cat "$expected")"
    if [ "$actual" = "$want" ]; then
        PASS=$((PASS + 1))
        if [ "${V:-0}" = "1" ]; then
            printf 'PASS  %s\n' "$rb"
        else
            printf '.'
        fi
    else
        FAIL=$((FAIL + 1))
        FAILED_FILES+=("$rb")
        if [ "${V:-0}" = "1" ]; then
            printf 'FAIL  %s\n' "$rb"
            diff -u <(printf '%s\n' "$want") <(printf '%s\n' "$actual") | sed 's/^/      /' >&2 || true
        else
            printf 'F'
        fi
    fi
}

function _collect() {
    local arg="$1"
    if [ -d "$arg" ]; then
        find "$arg" -type f -name '*.rb' | sort
    elif [ -f "$arg" ]; then
        printf '%s\n' "$arg"
    else
        printf 'eval-corpus-oracle: not a file or dir: %s\n' "$arg" >&2
        exit 2
    fi
}

function main() {
    if ! [ -x "$RUBY" ] && ! command -v "$RUBY" >/dev/null 2>&1; then
        printf 'eval-corpus-oracle: ruby binary not found: %s\n' "$RUBY" >&2
        printf '  hint: run `make rubies` to build pinned MRI binaries under .rubies/.\n' >&2
        printf '        or override with RUBY=<path> / ORACLE_VER=<x.y.z>.\n' >&2
        exit 2
    fi

    local targets=("$@")
    if [ ${#targets[@]} -eq 0 ]; then
        targets=("$DEFAULT_ROOT")
    fi

    for t in "${targets[@]}"; do
        while IFS= read -r f; do
            _check_one "$f"
        done < <(_collect "$t")
    done

    if [ "${V:-0}" != "1" ]; then
        printf '\n'
    fi

    printf 'eval-corpus-oracle: %d pass, %d fail, %d missing, %d skipped (%s)\n' \
        "$PASS" "$FAIL" "$MISSING" "$SKIPPED" "$RUBY"

    if [ ${#FAILED_FILES[@]} -gt 0 ]; then
        printf '\nfailing files:\n' >&2
        for f in "${FAILED_FILES[@]}"; do
            printf '  - %s\n' "$f" >&2
        done
        exit 1
    fi
}

main "$@"
