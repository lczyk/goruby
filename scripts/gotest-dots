#!/usr/bin/env bash
# Wrap `go test` output in pytest-style dots.
#   .  = PASS, F = FAIL, s = SKIP
# Failing test names are buffered and replayed at the end with their captured
# output. Successful / skipped test logs (t.Log / t.Skip messages) are
# suppressed -- they would otherwise hide the dot stream behind noise.
# `ok pkg` / `FAIL pkg` summary lines pass through unchanged.
# Exit code mirrors the wrapped command.
set -o pipefail

name="test"
if [ "${1:0:7}" = "--name=" ]; then
    name="${1:7}"
    shift
fi
outdir=".testoutput"
outfile="${outdir}/${name}.log"
mkdir -p "$outdir"
: > "$outfile"

# Dot-row width: prefer $COLUMNS, then stty/tput via /dev/tty (so width
# detection survives when stdout is piped through tee/less/make), then 80.
width="${COLUMNS:-}"
if [ -z "$width" ] && [ -r /dev/tty ]; then
    width=$(stty size </dev/tty 2>/dev/null | awk '{print $2}')
fi
if [ -z "$width" ] && [ -r /dev/tty ]; then
    width=$(tput cols </dev/tty 2>/dev/null || true)
fi
[ -n "$width" ] && [ "$width" -gt 0 ] 2>/dev/null || width=80

# Color when stdout is a tty and NO_COLOR is unset (per no-color.org).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    c_green=$'\033[32m'
    c_yellow=$'\033[33m'
    c_red=$'\033[31m'
    c_reset=$'\033[0m'
else
    c_green='' c_yellow='' c_red='' c_reset=''
fi

"$@" | LC_ALL=C awk -v width="$width" -v outfile="$outfile" \
    -v c_green="$c_green" -v c_yellow="$c_yellow" \
    -v c_red="$c_red" -v c_reset="$c_reset" '
function flush_dots() { if (in_dots) { printf "\n"; in_dots = 0; cnt_in_row = 0 } }
function emit(ch) {
    if (ch == ".") col = c_green
    else if (ch == "s" || ch == "x") col = c_yellow
    else if (ch == "F" || ch == "e") col = c_red
    else col = ""
    printf "%s%s%s", col, ch, (col == "" ? "" : c_reset)
    fflush()
    in_dots = 1
    if (++cnt_in_row >= width) { printf "\n"; cnt_in_row = 0 }
}
{
    # Buffer per-test output between === RUN and --- (PASS|FAIL|SKIP) so
    # that t.Fatal / t.Error messages (which print BEFORE --- FAIL) get
    # captured. Trailing indented lines after --- FAIL fold into that
    # test buffer too.
    if ($0 ~ /^[[:space:]]*=== RUN[[:space:]]/) {
        run_buf = ""; in_run = 1; post_fail = 0; next
    }
    if ($0 ~ /^[[:space:]]*=== (PAUSE|CONT|NAME)/) { next }
    if ($0 ~ /^[[:space:]]*--- PASS:/) {
        emit("."); npass++; in_run=0; run_buf=""; next
    }
    if ($0 ~ /^[[:space:]]*--- FAIL:/) {
        emit("F"); fails[++nf] = $0; fail_buf[nf] = run_buf
        run_buf=""; in_run=0; post_fail=nf; next
    }
    if ($0 ~ /^[[:space:]]*--- SKIP:/) {
        emit("s"); nskip++; in_run=0; run_buf=""; next
    }
    if ($0 == "PASS" || $0 == "FAIL") { in_run=0; post_fail=0; next }

    if (in_run) { run_buf = run_buf $0 "\n"; next }
    if (post_fail && $0 ~ /^[[:space:]]/) {
        fail_buf[post_fail] = fail_buf[post_fail] $0 "\n"; next
    }
    post_fail = 0
    flush_dots()
    print
}
END {
    flush_dots()
    if (nf > 0) {
        for (i = 1; i <= nf; i++) {
            print fails[i] >> outfile
            if (length(fail_buf[i]) > 0) printf "%s", fail_buf[i] >> outfile
        }
        printf "\n%s%d failed%s (see %s)\n", c_red, nf, c_reset, outfile
    }
    printf "totals: %d passed, %d failed, %d skipped\n", npass+0, nf+0, nskip+0
}
'
