# Skip list for ruby gem integration tests. Format:
#
#   <phase> <path-or-glob>[: reason]
#
# - <phase>: lex, parse, or walk
# - path or single-* glob, relative to internal/integrationtest/testdata/gems/
# - lines starting with # and blank lines are ignored
#
# Each entry is asserted to still fail; if the underlying phase now passes,
# the test reports `stale skip-list entry` and the line should be removed.
#
# example:
#   parse minitest/lib/minitest/spec.rb: heredoc not supported
#   parse minitest/test/*: rspec-style metaprogramming

# Ruby language tests from MRI test/ruby -- remaining parser gaps
parse mri-tests/test_keyword.rb: cascading from quoted string label in method args
parse mri-tests/test_pattern_matching.rb: cascading from complex %q{} patterns

walk mri-tests/test_keyword.rb: parse failed; walk skipped
walk mri-tests/test_pattern_matching.rb: parse failed; walk skipped

# esolang book code fragments -- excerpts, not standalone programs (intentionally invalid)
parse esolang-book-sources/1-2/03.rb: parser gaps
parse esolang-book-sources/1-4/07.rb: parser gaps

walk esolang-book-sources/1-2/03.rb: parse failed; walk skipped
walk esolang-book-sources/1-4/07.rb: parse failed; walk skipped
